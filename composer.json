{
    "name": "hexmakina/hopper",
    "description": "Router and reverse router based on AltoRouter",
    "type": "package",
    "require": {
        "php": ">=7.4",
        "hexmakina/black-box": "0.1.*",
        "altorouter/altorouter": "2.0.*"
    },
    "license": "mit",
    "authors": [
        {
            "name": "HexMakina",
            "email": "touch@hexmakina.be",
            "homepage": "https://hexmakina.be"
        }
    ],
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "HexMakina\\Hopper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HexMakina\\Hopper\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^9.6"
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    }
}
